# Created out-of-band — never commit the real file (see .gitignore:
# **/sms-webhook-secret.yaml). The TUNNEL_TOKEN comes from Terraform's
# sms_webhook_tunnel_token output (infra/cloudflare/sms-webhook.tf):
#
#   cd infra/cloudflare
#   terraform output -raw sms_webhook_tunnel_token > /tmp/sms-webhook-token.txt
#   kubectl -n moneymaker create secret generic sms-webhook-tunnel \
#     --from-literal=TUNNEL_TOKEN="$(cat /tmp/sms-webhook-token.txt)"
#   rm /tmp/sms-webhook-token.txt
#
# Re-apply (merge-safe) if the tunnel is ever recreated:
#
#   kubectl -n moneymaker create secret generic sms-webhook-tunnel \
#     --from-literal=TUNNEL_TOKEN="$(cat /tmp/sms-webhook-token.txt)" \
#     --dry-run=client -o yaml | kubectl apply -f -
apiVersion: v1
kind: Secret
metadata:
  name: sms-webhook-tunnel
  namespace: moneymaker
type: Opaque
stringData:
  TUNNEL_TOKEN: REPLACE_ME
