# DO NOT commit a real OpenD.xml to git — it contains plaintext brokerage
# credentials. Create the Secret from your local file instead:
#
#   # Copy your config (e.g. from ~/code/docker/opend/OpenD.xml) and ensure
#   # the <ip> element is 0.0.0.0 so the engine pod can reach OpenD across
#   # the cluster network. 127.0.0.1 will only bind inside the OpenD pod.
#
#   kubectl -n moneymaker create secret generic opend-config \
#     --from-file=OpenD.xml=/path/to/your/OpenD.xml
#
# Update with --dry-run | apply when the XML changes:
#
#   kubectl -n moneymaker create secret generic opend-config \
#     --from-file=OpenD.xml=/path/to/your/OpenD.xml \
#     --dry-run=client -o yaml | kubectl apply -f -
#
# Then bounce OpenD so the new file is mounted:
#
#   kubectl -n moneymaker rollout restart deploy/opend
#
# Required edits vs. the docker-compose copy:
#   <ip>0.0.0.0</ip>           # bind on all interfaces, not 127.0.0.1
#   <api_port>11111</api_port> # must match the Service targetPort
apiVersion: v1
kind: Secret
metadata:
  name: opend-config
  namespace: moneymaker
type: Opaque
stringData:
  OpenD.xml: |
    <moomoo_opend>
        <ip>0.0.0.0</ip>
        <api_port>11111</api_port>
        <login_account>REPLACE_ME</login_account>
        <login_pwd>REPLACE_ME</login_pwd>
        <lang>en</lang>
        <log_level>info</log_level>
        <push_proto_type>0</push_proto_type>
        <telnet_ip>127.0.0.1</telnet_ip>
        <telnet_port>22222</telnet_port>
        <price_reminder_push>1</price_reminder_push>
        <auto_hold_quote_right>1</auto_hold_quote_right>
        <future_trade_api_time_zone>UTC-4</future_trade_api_time_zone>
        <pdt_protection>1</pdt_protection>
        <dtcall_confirmation>1</dtcall_confirmation>
    </moomoo_opend>
