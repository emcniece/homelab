# DO NOT commit a real secret to git. Create it imperatively instead:
#
#   kubectl -n moneymaker create secret generic moneymaker-secrets \
#     --from-literal=ANTHROPIC_API_KEY='sk-ant-...' \
#     --from-literal=MOOMOO_TRADE_UNLOCK_PWD='your-trade-pwd'
#
# Or use sealed-secrets / external-secrets-operator in production.
apiVersion: v1
kind: Secret
metadata:
  name: moneymaker-secrets
  namespace: moneymaker
type: Opaque
stringData:
  ANTHROPIC_API_KEY: "REPLACE_ME"
  MOOMOO_TRADE_UNLOCK_PWD: ""  # leave empty for SIMULATE
