# DO NOT commit real secrets to git. Create them imperatively instead.
#
# 1. API key + (optional) trade unlock password
#
#   kubectl -n moneymaker create secret generic moneymaker-secrets \
#     --from-literal=ANTHROPIC_API_KEY='sk-ant-...' \
#     --from-literal=MOOMOO_TRADE_UNLOCK_PWD='your-trade-pwd'
#
# 2. RSA key shared with OpenD's <rsa_private_key>. Required when OpenD
#    binds to a non-loopback address — i.e. always in-cluster. MooMoo
#    rejects unencrypted trade calls across networks. Generate once:
#
#      openssl genrsa -traditional 1024 > rsa_key.pem
#
#    Same file goes into BOTH ends of the InitConnect handshake (engine
#    pod + opend pod). The deployment + opend-deployment both mount this
#    Secret as `moneymaker-rsa-key`.
#
#    kubectl -n moneymaker create secret generic moneymaker-rsa-key \
#      --from-file=rsa_key.pem=./rsa_key.pem
#
#    Then add `<rsa_private_key>/opend/rsa_key.pem</rsa_private_key>` to
#    the OpenD.xml in `opend-config` (see opend-secret.yaml.example) and
#    bounce both pods.
#
# Or use sealed-secrets / external-secrets-operator in production.
---
apiVersion: v1
kind: Secret
metadata:
  name: moneymaker-secrets
  namespace: moneymaker
type: Opaque
stringData:
  ANTHROPIC_API_KEY: "REPLACE_ME"
  MOOMOO_TRADE_UNLOCK_PWD: ""  # leave empty for SIMULATE
---
apiVersion: v1
kind: Secret
metadata:
  name: moneymaker-rsa-key
  namespace: moneymaker
type: Opaque
stringData:
  rsa_key.pem: |
    -----BEGIN RSA PRIVATE KEY-----
    REPLACE_ME
    -----END RSA PRIVATE KEY-----
