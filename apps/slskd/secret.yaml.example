# Copy to secret.yaml (gitignored via **/secret.yaml), fill in, then apply.
# Named .example (not .yaml) so `kubectl apply -f apps/slskd/` skips it:
#   kubectl --context homelab apply -f apps/slskd/secret.yaml
#   kubectl --context homelab -n media rollout restart deploy/slskd
apiVersion: v1
kind: Secret
metadata:
  name: slskd
  namespace: media
  labels:
    app: slskd
type: Opaque
stringData:
  # Soulseek network login. There's no sign-up: the first login with an
  # unused username creates the account. Unique password; the Soulseek
  # protocol isn't encrypted.
  SLSKD_SLSK_USERNAME: "CHANGE_ME"
  SLSKD_SLSK_PASSWORD: "CHANGE_ME"
  # slskd web UI login (slskd.lab.emc2.build).
  SLSKD_USERNAME: "CHANGE_ME"
  SLSKD_PASSWORD: "CHANGE_ME"
  # Primary API key, for Aurral. Administrator role (Aurral reads
  # /api/v0/options to find the downloads dir; ReadWrite gets 403), usable only from pod IPs
  # (Aurral calls the ClusterIP Service, so slskd sees the pod address).
  # Format: role=<Role>;cidr=<cidrs>;<16-255 char key>. Paste only the
  # trailing key into Aurral → Settings → Download clients → slskd.
  SLSKD_API_KEY: "role=Administrator;cidr=10.42.0.0/16;CHANGE_ME_32_CHARS_MIN"
  # Signs web UI sessions; set so restarts don't log everyone out.
  SLSKD_JWT_KEY: "CHANGE_ME_32_CHARS_MIN"
