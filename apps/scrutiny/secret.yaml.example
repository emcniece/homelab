# DO NOT commit a real secret to git. Create it imperatively instead:
#
#   kubectl -n scrutiny create secret generic scrutiny-influxdb \
#     --from-literal=INIT_PASSWORD="$(openssl rand -base64 24)" \
#     --from-literal=TOKEN="$(openssl rand -hex 32)"
#
# TOKEN is the InfluxDB admin token the web app will use once InfluxDB has
# been provisioned. INIT_PASSWORD is only consumed on InfluxDB's very first
# boot (self-provisioning happens via the web container's
# SCRUTINY_WEB_INFLUXDB_INIT_* env vars — see web-deployment.yaml). If you
# ever wipe the influxdb-data PVC, both values are reused to re-provision.
#
# Or use sealed-secrets / external-secrets-operator in production.
#
# SMTP/notification config (optional — web-deployment.yaml treats this as
# optional, so the app still starts without it). Scrutiny takes a single
# Shoutrrr-style URL rather than discrete SMTP fields:
#
#   kubectl -n scrutiny create secret generic scrutiny-notify \
#     --from-literal=URLS='smtp://user:pass@host:port/?fromAddress=scrutiny@example.com&toAddresses=you@example.com'
#
# Special characters in the username/password must be urlencoded.
# Multiple targets (including non-SMTP ones — Discord, Slack, ntfy, etc.)
# are comma-separated in the same URLS value.
#
# NOTE: if you already set SMTP up via the web UI's Settings page, that went
# through the separate /api/settings/notify-urls API and is stored in
# scrutiny.db (on the scrutiny-web-config PVC) — a DIFFERENT, independent
# target list from this env var, not one overriding the other. Once this
# secret is confirmed working, delete the UI-configured entry (Settings ->
# Notifications, or DELETE /api/settings/notify-urls/{id}) or you'll get
# duplicate notifications from both lists.
---
apiVersion: v1
kind: Secret
metadata:
  name: scrutiny-influxdb
  namespace: scrutiny
type: Opaque
stringData:
  INIT_PASSWORD: "REPLACE_ME"
  TOKEN: "REPLACE_ME"
---
apiVersion: v1
kind: Secret
metadata:
  name: scrutiny-notify
  namespace: scrutiny
type: Opaque
stringData:
  URLS: "REPLACE_ME"
