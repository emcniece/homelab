  Move the protected pod(s) off k3s-05 first, then re-run this script.
    # CNPG cluster belay/belay-pg: pick a replica on another node, then make it primary
    kubectl -n belay get pods -l cnpg.io/cluster=belay-pg -L cnpg.io/instanceRole -o wide
    kubectl -n belay patch cluster belay-pg --type merge --subresource status -p '{"status":{"targetPrimary":"<replica-pod-name>"}}'
    kubectl -n belay get cluster belay-pg -w   # wait for the new primary and "Cluster in healthy state"
    # CNPG cluster glyphdex/glyphdex-pg: pick a replica on another node, then make it primary
    kubectl -n glyphdex get pods -l cnpg.io/cluster=glyphdex-pg -L cnpg.io/instanceRole -o wide
    kubectl -n glyphdex patch cluster glyphdex-pg --type merge --subresource status -p '{"status":{"targetPrimary":"<replica-pod-name>"}}'
    kubectl -n glyphdex get cluster glyphdex-pg -w   # wait for the new primary and "Cluster in healthy state"
