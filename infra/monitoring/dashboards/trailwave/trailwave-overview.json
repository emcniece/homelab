{
  "title": "Trailwave — Overview",
  "uid": "trailwave-overview",
  "tags": ["trailwave", "app"],
  "timezone": "",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-3h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "label": "Prometheus",
        "current": { "text": "Prometheus", "value": "prometheus" }
      },
      {
        "name": "environment",
        "type": "query",
        "label": "Environment",
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "query": {
          "query": "label_values(trailwave_campaigns_total, environment)",
          "refId": "A"
        },
        "refresh": 2,
        "sort": 1,
        "multi": false,
        "includeAll": true,
        "allValue": ".*",
        "current": {}
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Campaign data",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Campaigns",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [{ "expr": "trailwave_campaigns_total{app=\"trailwave\",environment=~\"$environment\"}", "refId": "A" }],
      "options": { "colorMode": "value", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "blue" } } }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Volunteers",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [{ "expr": "trailwave_volunteers_total{app=\"trailwave\",environment=~\"$environment\"}", "refId": "A" }],
      "options": { "colorMode": "value", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "green" } } }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Active shifts",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [{ "expr": "trailwave_shifts_total{app=\"trailwave\",environment=~\"$environment\",status=\"ACTIVE\"}", "refId": "A" }],
      "options": { "colorMode": "value", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "orange" } } }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Sign placements",
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [{ "expr": "trailwave_sign_placements_total{app=\"trailwave\",environment=~\"$environment\"}", "refId": "A" }],
      "options": { "colorMode": "value", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "purple" } } }
    },
    {
      "id": 6,
      "type": "piechart",
      "title": "Shifts by status",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [{ "expr": "trailwave_shifts_total{app=\"trailwave\",environment=~\"$environment\"}", "refId": "A", "legendFormat": "{{status}}" }],
      "options": { "pieType": "donut", "legendDisplayMode": "table", "placement": "right" }
    },
    {
      "id": 7,
      "type": "piechart",
      "title": "Walk events by status",
      "gridPos": { "h": 4, "w": 8, "x": 0, "y": 5 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [{ "expr": "trailwave_walk_events_total{app=\"trailwave\",environment=~\"$environment\"}", "refId": "A", "legendFormat": "{{status}}" }],
      "options": { "pieType": "donut", "legendDisplayMode": "list", "placement": "right" }
    },
    {
      "id": 8,
      "type": "row",
      "title": "tRPC request rate",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
      "collapsed": false
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Requests/s by procedure",
      "gridPos": { "h": 8, "w": 16, "x": 0, "y": 10 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "topk(10, sum by (procedure) (rate(trailwave_trpc_requests_total{app=\"trailwave\",environment=~\"$environment\",status=\"ok\"}[2m])))",
          "refId": "A",
          "legendFormat": "{{procedure}}"
        }
      ],
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "max"] } },
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line", "fillOpacity": 10 }, "unit": "reqps" } }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Error rate by procedure",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 10 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "sum by (procedure) (rate(trailwave_trpc_requests_total{app=\"trailwave\",environment=~\"$environment\",status=\"error\"}[2m]))",
          "refId": "A",
          "legendFormat": "{{procedure}}"
        }
      ],
      "options": { "tooltip": { "mode": "multi" } },
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line", "fillOpacity": 20 }, "unit": "reqps", "color": { "mode": "fixed", "fixedColor": "red" } } }
    },
    {
      "id": 11,
      "type": "row",
      "title": "tRPC latency",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 18 },
      "collapsed": false
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "P50 latency by procedure",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 19 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "topk(8, histogram_quantile(0.5, sum by (procedure, le) (rate(trailwave_trpc_request_duration_seconds_bucket{app=\"trailwave\",environment=~\"$environment\"}[2m]))))",
          "refId": "A",
          "legendFormat": "{{procedure}}"
        }
      ],
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean"] } },
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "drawStyle": "line", "fillOpacity": 5 } } }
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "P95 / P99 latency (all procedures)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 19 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(trailwave_trpc_request_duration_seconds_bucket{app=\"trailwave\",environment=~\"$environment\"}[2m])))",
          "refId": "A",
          "legendFormat": "p95"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(trailwave_trpc_request_duration_seconds_bucket{app=\"trailwave\",environment=~\"$environment\"}[2m])))",
          "refId": "B",
          "legendFormat": "p99"
        }
      ],
      "options": { "tooltip": { "mode": "multi" } },
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "drawStyle": "line", "fillOpacity": 5 } } }
    },
    {
      "id": 14,
      "type": "row",
      "title": "Node.js runtime",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 27 },
      "collapsed": false
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Heap used / total",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 28 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "trailwave_node_nodejs_heap_size_used_bytes{app=\"trailwave\",environment=~\"$environment\"}",
          "refId": "A",
          "legendFormat": "heap used"
        },
        {
          "expr": "trailwave_node_nodejs_heap_size_total_bytes{app=\"trailwave\",environment=~\"$environment\"}",
          "refId": "B",
          "legendFormat": "heap total"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "bytes", "custom": { "drawStyle": "line", "fillOpacity": 10 } } }
    },
    {
      "id": 16,
      "type": "timeseries",
      "title": "Event loop lag (p50 / p99)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 28 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, rate(trailwave_node_nodejs_eventloop_lag_seconds_bucket{app=\"trailwave\",environment=~\"$environment\"}[2m]))",
          "refId": "A",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.99, rate(trailwave_node_nodejs_eventloop_lag_seconds_bucket{app=\"trailwave\",environment=~\"$environment\"}[2m]))",
          "refId": "B",
          "legendFormat": "p99"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "drawStyle": "line", "fillOpacity": 5 } } }
    },
    {
      "id": 17,
      "type": "timeseries",
      "title": "GC duration (total rate)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 36 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "sum by (gctype) (rate(trailwave_node_nodejs_gc_duration_seconds_sum{app=\"trailwave\",environment=~\"$environment\"}[2m]))",
          "refId": "A",
          "legendFormat": "{{gctype}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s/s", "custom": { "drawStyle": "bars", "fillOpacity": 60 } } }
    },
    {
      "id": 18,
      "type": "timeseries",
      "title": "Active handles / requests",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 36 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "trailwave_node_nodejs_active_handles{app=\"trailwave\",environment=~\"$environment\"}",
          "refId": "A",
          "legendFormat": "handles"
        },
        {
          "expr": "trailwave_node_nodejs_active_requests{app=\"trailwave\",environment=~\"$environment\"}",
          "refId": "B",
          "legendFormat": "requests"
        }
      ],
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line", "fillOpacity": 10 } } }
    }
  ]
}
