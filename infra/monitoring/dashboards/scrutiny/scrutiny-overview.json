{
  "title": "Scrutiny — Disk Health",
  "uid": "scrutiny-overview",
  "tags": ["scrutiny", "smart", "disks"],
  "timezone": "",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "5m",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "influxdb",
        "label": "InfluxDB",
        "current": {
          "text": "Scrutiny InfluxDB",
          "value": "scrutiny-influxdb"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Devices monitored",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "datasource": { "type": "influxdb", "uid": "${datasource}" },
      "targets": [
        {
          "query": "import \"influxdata/influxdb/schema\"\nschema.tagValues(bucket: \"metrics\", tag: \"device_id\", predicate: (r) => r._measurement == \"smart\", start: -30d)\n  |> count()\n  |> yield(name: \"count\")",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "blue", "value": null }]
          },
          "noValue": "0"
        }
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Devices with SMART issues",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
      "datasource": { "type": "influxdb", "uid": "${datasource}" },
      "description": "Devices where any SMART attribute's status code is non-zero (0 = passed) as of its most recent scan.",
      "targets": [
        {
          "query": "from(bucket: \"metrics\")\n  |> range(start: -30d)\n  |> filter(fn: (r) => r._measurement == \"smart\")\n  |> filter(fn: (r) => r._field =~ /^attr\\..*\\.status$/)\n  |> last()\n  |> filter(fn: (r) => r._value != 0)\n  |> group(columns: [\"device_id\"])\n  |> distinct(column: \"device_id\")\n  |> group()\n  |> count()\n  |> yield(name: \"count\")",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          },
          "noValue": "0"
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Max temperature (°C)",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 },
      "datasource": { "type": "influxdb", "uid": "${datasource}" },
      "targets": [
        {
          "query": "from(bucket: \"metrics\")\n  |> range(start: -1d)\n  |> filter(fn: (r) => r._measurement == \"temp\" and r._field == \"temp\")\n  |> last()\n  |> group()\n  |> max()\n  |> yield(name: \"max\")",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 45 },
              { "color": "red", "value": 55 }
            ]
          }
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Temperature by device",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 4 },
      "datasource": { "type": "influxdb", "uid": "${datasource}" },
      "targets": [
        {
          "query": "from(bucket: \"metrics\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"temp\" and r._field == \"temp\")\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)\n  |> keep(columns: [\"_time\", \"_value\", \"device_id\"])\n  |> yield(name: \"temp\")",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "custom": { "drawStyle": "line", "spanNulls": true }
        }
      }
    },
    {
      "id": 5,
      "type": "table",
      "title": "Power-on hours / power cycles by device",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "datasource": { "type": "influxdb", "uid": "${datasource}" },
      "targets": [
        {
          "query": "from(bucket: \"metrics\")\n  |> range(start: -30d)\n  |> filter(fn: (r) => r._measurement == \"smart\")\n  |> filter(fn: (r) => r._field == \"power_on_hours\" or r._field == \"power_cycle_count\")\n  |> last()\n  |> pivot(rowKey: [\"device_id\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> group()\n  |> keep(columns: [\"device_id\", \"device_wwn\", \"power_on_hours\", \"power_cycle_count\"])\n  |> yield(name: \"device_power_stats\")",
          "refId": "A"
        }
      ],
      "transformations": [
        { "id": "organize", "options": { "excludeByName": {}, "renameByName": {} } }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "power_on_hours" },
            "properties": [{ "id": "displayName", "value": "Power-on hours" }]
          },
          {
            "matcher": { "id": "byName", "options": "power_cycle_count" },
            "properties": [{ "id": "displayName", "value": "Power cycles" }]
          },
          {
            "matcher": { "id": "byName", "options": "device_id" },
            "properties": [{ "id": "displayName", "value": "Device" }]
          }
        ]
      }
    },
    {
      "id": 6,
      "type": "table",
      "title": "Key SMART attributes (reallocated/pending/uncorrectable sectors, defect list)",
      "description": "Covers both ATA (attrs 5/197/198) and SCSI/SAS (scsi_grown_defect_list) drives. Blank cells mean that attribute doesn't apply to that device's protocol.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "datasource": { "type": "influxdb", "uid": "${datasource}" },
      "targets": [
        {
          "query": "from(bucket: \"metrics\")\n  |> range(start: -30d)\n  |> filter(fn: (r) => r._measurement == \"smart\")\n  |> filter(fn: (r) => r._field == \"attr.5.raw_value\" or r._field == \"attr.5.status\"\n                     or r._field == \"attr.197.raw_value\" or r._field == \"attr.197.status\"\n                     or r._field == \"attr.198.raw_value\" or r._field == \"attr.198.status\"\n                     or r._field == \"attr.scsi_grown_defect_list.raw_value\" or r._field == \"attr.scsi_grown_defect_list.status\")\n  |> last()\n  |> pivot(rowKey: [\"device_id\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> group()\n  |> yield(name: \"key_attrs\")",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "device_id" },
            "properties": [{ "id": "displayName", "value": "Device" }]
          },
          {
            "matcher": { "id": "byName", "options": "attr.5.raw_value" },
            "properties": [{ "id": "displayName", "value": "Reallocated sectors" }]
          },
          {
            "matcher": { "id": "byName", "options": "attr.5.status" },
            "properties": [
              { "id": "displayName", "value": "Reallocated status" },
              { "id": "custom.cellOptions", "value": { "type": "color-background" } },
              { "id": "mappings", "value": [
                { "type": "value", "options": { "0": { "text": "OK", "color": "green" } } },
                { "type": "range", "options": { "from": 1, "to": 999999, "result": { "text": "Attention", "color": "red" } } }
              ]}
            ]
          },
          {
            "matcher": { "id": "byName", "options": "attr.197.raw_value" },
            "properties": [{ "id": "displayName", "value": "Pending sectors" }]
          },
          {
            "matcher": { "id": "byName", "options": "attr.197.status" },
            "properties": [
              { "id": "displayName", "value": "Pending status" },
              { "id": "custom.cellOptions", "value": { "type": "color-background" } },
              { "id": "mappings", "value": [
                { "type": "value", "options": { "0": { "text": "OK", "color": "green" } } },
                { "type": "range", "options": { "from": 1, "to": 999999, "result": { "text": "Attention", "color": "red" } } }
              ]}
            ]
          },
          {
            "matcher": { "id": "byName", "options": "attr.198.raw_value" },
            "properties": [{ "id": "displayName", "value": "Uncorrectable sectors" }]
          },
          {
            "matcher": { "id": "byName", "options": "attr.198.status" },
            "properties": [
              { "id": "displayName", "value": "Uncorrectable status" },
              { "id": "custom.cellOptions", "value": { "type": "color-background" } },
              { "id": "mappings", "value": [
                { "type": "value", "options": { "0": { "text": "OK", "color": "green" } } },
                { "type": "range", "options": { "from": 1, "to": 999999, "result": { "text": "Attention", "color": "red" } } }
              ]}
            ]
          },
          {
            "matcher": { "id": "byName", "options": "attr.scsi_grown_defect_list.raw_value" },
            "properties": [{ "id": "displayName", "value": "SCSI grown defects" }]
          },
          {
            "matcher": { "id": "byName", "options": "attr.scsi_grown_defect_list.status" },
            "properties": [
              { "id": "displayName", "value": "SCSI defect status" },
              { "id": "custom.cellOptions", "value": { "type": "color-background" } },
              { "id": "mappings", "value": [
                { "type": "value", "options": { "0": { "text": "OK", "color": "green" } } },
                { "type": "range", "options": { "from": 1, "to": 999999, "result": { "text": "Attention", "color": "red" } } }
              ]}
            ]
          }
        ]
      }
    }
  ]
}
