{
  "uid": "glyphdex-performance",
  "title": "Glyphdex \u2014 Performance",
  "tags": [
    "glyphdex"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "type": "row",
      "title": "Containers / runtime",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "type": "timeseries",
      "title": "Container CPU cores",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "expr": "sum by (container) (rate(container_cpu_usage_seconds_total{namespace=\"glyphdex\", container!=\"\"}[5m]))",
          "legendFormat": "{{container}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Container memory (working set)",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        }
      },
      "targets": [
        {
          "expr": "sum by (container) (container_memory_working_set_bytes{namespace=\"glyphdex\", container!=\"\"})",
          "legendFormat": "{{container}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Targets up by job",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1
        }
      },
      "targets": [
        {
          "expr": "up{job=~\"web|mcp-server|worker|extractor|capture|postgres\"}",
          "legendFormat": "{{job}}"
        }
      ]
    },
    {
      "type": "row",
      "title": "App latency & errors",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 9
      }
    },
    {
      "type": "timeseries",
      "title": "Web latency p50/p95/p99 (s)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 10
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum(rate(glyphdex_http_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(glyphdex_http_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(glyphdex_http_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Web request rate by status",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 10
      },
      "targets": [
        {
          "expr": "sum by (status) (rate(glyphdex_http_requests_total[5m]))",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Web 5xx ratio",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 18
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        }
      },
      "targets": [
        {
          "expr": "sum(rate(glyphdex_http_requests_total{status=~\"5..\"}[5m])) / clamp_min(sum(rate(glyphdex_http_requests_total[5m])), 1)",
          "legendFormat": "5xx ratio"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "MCP tool p95 by tool (s)",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 18
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(glyphdex_mcp_tool_duration_seconds_bucket[10m])) by (le, tool))",
          "legendFormat": "{{tool}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Retrieval leg p95 (s)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 25
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(glyphdex_search_duration_seconds_bucket[10m])) by (le))",
          "legendFormat": "search"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(glyphdex_vector_search_duration_seconds_bucket[10m])) by (le))",
          "legendFormat": "vector"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(glyphdex_lexical_search_duration_seconds_bucket[10m])) by (le))",
          "legendFormat": "lexical"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(glyphdex_rerank_duration_seconds_bucket[10m])) by (le))",
          "legendFormat": "rerank"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Embed + financial query p95 (s)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 25
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(glyphdex_embed_duration_seconds_bucket[10m])) by (le))",
          "legendFormat": "embed"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(glyphdex_financial_query_duration_seconds_bucket[10m])) by (le))",
          "legendFormat": "financial"
        }
      ]
    },
    {
      "type": "row",
      "title": "Ingest & sidecars",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 33
      }
    },
    {
      "type": "stat",
      "title": "Ingest queue depth",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 34
      },
      "targets": [
        {
          "expr": "max(glyphdex_ingest_queue_depth)"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Oldest ingest job (s)",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 6,
        "y": 34
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "targets": [
        {
          "expr": "max(glyphdex_ingest_queue_oldest_seconds)"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Ollama up",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 12,
        "y": 34
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "max(glyphdex_ollama_up)"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Extractor fail ratio",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 18,
        "y": 34
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        }
      },
      "targets": [
        {
          "expr": "sum(rate(glyphdex_extract_requests_total{result!~\"ok|empty\"}[15m])) / clamp_min(sum(rate(glyphdex_extract_requests_total[15m])), 1)"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Ingest stage p95 duration (s)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 39
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(glyphdex_ingest_job_duration_seconds_bucket[30m])) by (le, stage))",
          "legendFormat": "{{stage}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Capture duration p95 (s)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 39
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(glyphdex_capture_duration_seconds_bucket[30m])) by (le))",
          "legendFormat": "capture"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Extractor requests/s by pod",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 47
      },
      "targets": [
        {
          "expr": "sum by (instance) (rate(glyphdex_extract_requests_total[5m]))",
          "legendFormat": "{{instance}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Extractor in-flight by pod",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 47
      },
      "targets": [
        {
          "expr": "glyphdex_extract_in_flight",
          "legendFormat": "{{instance}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Ingest jobs by worker lane (heavy / jumbo / light)",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 55
      },
      "targets": [
        {
          "expr": "glyphdex_ingest_lane_jobs",
          "legendFormat": "{{lane}} - {{state}}"
        }
      ]
    },
    {
      "type": "row",
      "title": "Postgres",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 63
      }
    },
    {
      "type": "timeseries",
      "title": "Connections in use",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 64
      },
      "targets": [
        {
          "expr": "sum(cnpg_backends_total) by (instance)",
          "legendFormat": "{{instance}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Commits + rollbacks / s",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 64
      },
      "targets": [
        {
          "expr": "sum(rate(cnpg_pg_stat_database_xact_commit[5m]))",
          "legendFormat": "commit"
        },
        {
          "expr": "sum(rate(cnpg_pg_stat_database_xact_rollback[5m]))",
          "legendFormat": "rollback"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Database size",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 64
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        }
      },
      "targets": [
        {
          "expr": "max(cnpg_pg_database_size_bytes{datname=\"glyphdex\"})",
          "legendFormat": "glyphdex"
        }
      ]
    }
  ]
}